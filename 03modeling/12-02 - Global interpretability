m sklearn.inspection import PartialDependenceDisplay\n","import matplotlib.pyplot as plt\n","\n","brf.fit(X, y)\n","\n","# Generate PDP for specific features\n","features_to_plot = ['Age', 'Number.of.sexual.partners', 'First.sexual.intercourse',\n","                    'Num.of.pregnancies', 'Smokes', 'Smokes..years.', 'Hormonal.Contraceptives',\n","                    'Hormonal.Contraceptives..years.', 'IUD', 'IUD..years.', 'STDs', 'STDs..number.',\n","                    'STDs..Number.of.diagnosis', 'STDs..Time.since.first.diagnosis', 'STDs..Time.since.last.diagnosis']\n","\n","fig, ax = plt.subplots(figsize=(12, 16))  # Adjust figure size\n","PartialDependenceDisplay.from_estimator(\n","    brf,\n","    X,\n","    features=features_to_plot,\n","    ax=ax\n",")\n","\n","# Improve label visibility\n","plt.xticks(rotation=45, fontsize=12)  # Rotate x-axis labels\n","plt.yticks(fontsize=12)               # Adjust y-axis label font size\n","plt.tight_layout()                    # Prevent label clipping\n","plt.show()"],"metadata":{"id":"8V73JbPE7b7o","colab":{"base_uri":"https://localhost:8080/","height":982},"executionInfo":{"status":"ok","timestamp":1733150287405,"user_tz":300,"elapsed":11803,"user":{"displayName":"Fernando Pasquini","userId":"05908162714866376060"}},"outputId":"fe85fb9c-b52c-4198-f2d0-8d5b2491ce8f"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.10/dist-packages/imblearn/ensemble/_forest.py:577: FutureWarning: The default of `sampling_strategy` will change from `'auto'` to `'all'` in version 0.13. This change will follow the implementation proposed in the original paper. Set to `'all'` to silence this warning and adopt the future behaviour.\n","  warn(\n","/usr/local/lib/python3.10/dist-packages/imblearn/ensemble/_forest.py:589: FutureWarning: The default of `replacement` will change from `False` to `True` in version 0.13. This change will follow the implementation proposed in the original paper. Set to `True` to silence this warning and adopt the future behaviour.\n","  warn(\n","/usr/local/lib/python3.10/dist-packages/imblearn/ensemble/_forest.py:601: FutureWarning: The default of `bootstrap` will change from `True` to `False` in version 0.13. This change will follow the implementation proposed in the original paper. Set to `False` to silence this warning and adopt the future behaviour.\n","  warn(\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x1600 with 16 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["**The good**:\n","- It is intuitive. \"Given that everything is kept constant, this is the average prediction when this feature value changes\".\n","\n","**The bad**:\n","- It is assumed that the feature(s) for which the partial dependence is computed are not correlated with other features.\n","- This is false even in our dataset: it is obvious that \"Hormonal Contraceptives in Years\" is correlated to age!\n","  - Our calculations, however, are supposing that it is plausbible to have someone with 23 years old and 20 years taking contraceptives..."],"metadata":{"id":"ze9gwaBn9BHl"}},{"cell_type":"markdown","source":["# Accumulated Local Effects (ALE)\n","\n","- One of the solutions to the problem above: calculate how much the prediction is varying around a certain value.\n","- For example, if I'm age 40, how much does the prediction varies going from age 39 to 41?"],"metadata":{"id":"V88u5xMZAP6A"}},{"cell_type":"code","source":["import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","def calculate_ale(X, model, feature, grid_size=20):\n","    \"\"\"\n","    Calculate ALE for a given feature.\n","\n","    Parameters:\n","    - X: DataFrame or NumPy array, feature matrix.\n","    - model: Trained model with a predict method.\n","    - feature_idx: Index of the feature for which to compute ALE.\n","    - grid_size: Number of bins to divide the feature range.\n","\n","    Returns:\n","    - ale_values: ALE values for the feature bins.\n","    - bin_centers: Centers of the bins used for calculation.\n","    \"\"\"\n","    # Sort feature values into bins\n","    feature_values = X[feature]\n","    min_val, max_val = feature_values.min(), feature_values.max()\n","    bins = np.linspace(min_val, max_val, grid_size + 1)\n","    bin_centers = 0.5 * (bins[:-1] + bins[1:])\n","\n","    # Compute ALE\n","    ale_values = []\n","    for i in range(len(bins) - 1):\n","        in_bin = (feature_values >= bins[i]) & (feature_values < bins[i + 1])\n","        if not np.any(in_bin):\n","            ale_values.append(0)\n","            continue\n","\n","        # Perturb feature values within the bin\n","        X_lower = X.copy()\n","        X_upper = X.copy()\n","        X_lower.loc[in_bin, feature] = bins[i]\n","        X_upper.loc[in_bin, feature] = bins[i + 1]\n","\n","        # Model predictions for perturbed data\n","        preds_lower = model.predict(X_lower)\n","        preds_upper = model.predict(X_upper)\n","\n","        # Calculate differences and average over instances in the bin\n","        diffs = preds_upper - preds_lower\n","        ale_values.append(np.mean(diffs))\n","\n","    # Accumulate the effects\n","    ale_values = np.cumsum(ale_values)\n","    ale_values -= np.mean(ale_values)  # Center ALE\n","\n","    return ale_values, bin_centers\n","\n","# Example usage for a feature\n","feature_idx = 0  # Index of the feature to analyze\n","ale_values, bin_centers = calculate_ale(X, brf, 'Age', grid_size=20)\n","\n","# Plot ALE\n","plt.figure(figsize=(8, 6))\n","plt.plot(bin_centers, ale_values, marker=\"o\")\n","plt.title(f\"Accumulated Local Effect for Feature 'Age'\", fontsize=16)\n","plt.xlabel(f\"Feature {feature_idx}\", fontsize=14)\n","plt.ylabel(\"ALE\", fontsize=14)\n","plt.grid()\n","plt.show()"],"metadata":{"id":"mdO_zpfnBtp5","colab":{"base_uri":"https://localhost:8080/","height":504},"executionInfo":{"status":"ok","timestamp":1733150566152,"user_tz":300,"elapsed":780,"user":{"displayName":"Fernando Pasquini","userId":"05908162714866376060"}},"outputId":"a6b7bc75-19e8-4b3f-8be1-4541c22ae6e0"},"execution_count":15,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# Permutation Feature Importance\n","\n","Measures the increase in the prediction error of the model after we permuted the feature’s values, which breaks the relationship between the feature and the true outcome.\n","- A feature is “important” if shuffling its values increases the model error, because in this case the model relied on the feature for the prediction. A feature is “unimportant” if shuffling its values leaves the model error unchanged, because in this case the model ignored the feature for the prediction."],"metadata":{"id":"nkvunX9dEh0D"}},{"cell_type":"code","source":["from sklearn.inspection import permutation_importance\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","# Perform permutation feature importance\n","perm_importance = permutation_importance(\n","    brf, X, y, scoring=\"roc_auc\", n_repeats=10, random_state=42\n",")\n","\n","# Organize results into a DataFrame\n","feature_importances = pd.DataFrame({\n","    \"Feature\": X.columns,\n","    \"Importance\": perm_importance.importances_mean,\n","    \"Std Dev\": perm_importance.importances_std\n","}).sort_values(by=\"Importance\", ascending=False)\n","\n","# Display the results\n","print(\"Permutation Feature Importance Results:\")\n","print(feature_importances)\n","\n","# Plot feature importances\n","plt.figure(figsize=(12, 8))\n","plt.barh(feature_importances[\"Feature\"], feature_importances[\"Importance\"], xerr=feature_importances[\"Std Dev\"])\n","plt.gca().invert_yaxis()  # Invert y-axis to have the most important feature at the top\n","plt.title(\"Permutation Feature Importance\", fontsize=16)\n","plt.xlabel(\"Mean Importance\", fontsize=14)\n","plt.ylabel(\"Features\", fontsize=14)\n","plt.grid(axis=\"x\")\n","plt.show()"],"metadata":{"id":"XH2sA9nREiMj","colab":{"base_uri":"https://localhost:8080/","height":680},"executionInfo":{"status":"ok","timestamp":1733150735210,"user_tz":300,"elapsed":3053,"user":{"displayName":"Fernando Pasquini","userId":"05908162714866376060"}},"outputId":"1db65fb2-04ab-4257-dab4-c015d397dd45"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["Permutation Feature Importance Results:\n","                             Feature  Importance   Std Dev\n","7    Hormonal.Contraceptives..years.    0.106350  0.015606\n","0                                Age    0.089262  0.006375\n","2           First.sexual.intercourse    0.084933  0.015687\n","1          Number.of.sexual.partners    0.080992  0.013450\n","3                 Num.of.pregnancies    0.065141  0.009487\n","6            Hormonal.Contraceptives    0.027945  0.004896\n","5                     Smokes..years.    0.011869  0.003395\n","4                             Smokes    0.007634  0.003847\n","9                        IUD..years.    0.007311  0.001550\n","11                     STDs..number.    0.002418  0.001068\n","8                                IUD    0.001986  0.000803\n","10                              STDs    0.000987  0.000652\n","13  STDs..Time.since.first.diagnosis    0.000907  0.000315\n","12         STDs..Number.of.diagnosis    0.000500  0.000534\n","14   STDs..Time.since.last.diagnosis   -0.001085  0.000228\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# Feature Interaction\n","\n","Feature interaction occurs when the effect of one feature on the model's predictions depends on the value of another feature.\n","  - In other words, the combined influence of two or more features on the outcome is **not simply additive**.\n","\n","For example:\n","  - Age and blood pressure usually don't interact when predicting cervical cancer\n","  - However, smoking habit and HPV Infection, however, lead together to an increased odds of cervical cancer. Smoking weakens the immune system, making it harder for the body to clear HPV infections.\n","\n","## H-Statistic\n","\n","The H-Statistic is a measurement of feature interaction. It provides a numerical value (between 0 and 1) that represents the degree of interaction between a pair of features, with:\n","- 0 indicating no interaction (purely additive effects).\n","- 1 indicating a strong interaction (completely dependent interaction).\n","\n","Problem: it takes looooooong to execute!"],"metadata":{"id":"IdVoMzDMJW8y"}},{"cell_type":"markdown","source":["Molnar et al. (2017) already did that for us:\n","\n","![](https://christophm.github.io/interpretable-ml-book/images/interaction-cervical-1.png)\n","\n","![](https://christophm.github.io/interpretable-ml-book/images/interaction2-cervical-age-1.png)"],"metadata":{"id":"vH6qSBSPaRgV"}},{"cell_type":"markdown","source":["# Global Surrogate Models\n","\n","- \"A global surrogate model is an interpretable model that is trained to approximate the predictions of a black box model. We can draw conclusions about the black box model by interpreting the surrogate model.\"\n","\n","Steps:\n","1. **Generate Predictions**:\n","   - Use the trained complex model to generate predictions on the training dataset.\n","2. **Train the Surrogate**:\n","   - Train a simple, interpretable model (e.g., Decision Tree) using the original features and the predictions from the complex model as the target.\n","3. **Evaluate and Visualize**:\n","   - Use feature importance or other methods to analyze the surrogate model, which approximates the behavior of the complex model."],"metadata":{"id":"L13sMabZWyh_"}},{"cell_type":"code","source":["from sklearn.tree import DecisionTreeClassifier, export_text\n","from sklearn.metrics import mean_squared_error\n","import matplotlib.pyplot as plt\n","\n","X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.1, random_state=42, stratify=y)\n","\n","# Step 1: Generate predictions from the complex model (e.g., Random Forest)\n","brf_predictions = brf.predict(X_train)\n","\n","# Step 2: Train a Decision Tree as the surrogate model\n","surrogate = DecisionTreeClassifier(max_depth=3, random_state=42)\n","surrogate.fit(X_train, brf_predictions)\n","\n","# Step 3: Evaluate the surrogate model\n","surrogate_predictions = surrogate.predict(X_train)\n","print(\"Classification Report for Surrogate Model:\")\n","print(classification_report(brf_predictions, surrogate_predictions))\n","\n","# Step 4: Visualize the surrogate model (feature importance or tree structure)\n","print(\"\\nSurrogate Model Decision Rules:\")\n","print(export_text(surrogate, feature_names=list(X.columns)))"],"metadata":{"id":"b-_nnZn6FrfM","executionInfo":{"status":"ok","timestamp":1733147021838,"user_tz":300,"elapsed":92,"user":{"displayName":"Fernando Pasquini","userId":"05908162714866376060"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"38898247-ff9d-438d-d4d4-1dc6cda61a35"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Classification Report for Surrogate Model:\n","              precision    recall  f1-score   support\n","\n","         0.0       0.72      1.00      0.83       479\n","         1.0       0.98      0.35      0.52       293\n","\n","    accuracy                           0.75       772\n","   macro avg       0.85      0.68      0.68       772\n","weighted avg       0.82      0.75      0.71       772\n","\n","\n","Surrogate Model Decision Rules:\n","|--- STDs..Number.of.diagnosis <= 0.50\n","|   |--- Hormonal.Contraceptives..years. <= 8.50\n","|   |   |--- Num.of.pregnancies <= 2.50\n","|   |   |   |--- class: 0.0\n","|   |   |--- Num.of.pregnancies >  2.50\n","|   |   |   |--- class: 0.0\n","|   |--- Hormona