\n","prototypes = kmeans.cluster_centers_  # Cluster centers are the prototypes\n","\n","# Step 3: Assign each data point to its closest prototype\n","distances = euclidean_distances(data, prototypes)\n","assigned_prototypes = np.argmin(distances, axis=1)\n","\n","# Step 4: Find criticisms\n","# Criticisms are data points with the largest distance to their assigned prototype\n","criticism_indices = np.argsort(np.max(distances, axis=1))[-n_prototypes:]\n","criticisms = data[criticism_indices]\n","\n","# Step 5: Visualize prototypes and criticisms\n","print(\"Prototypes (Cluster Centers):\")\n","print(prototypes)\n","\n","print(\"\\nCriticisms (Most Atypical Points):\")\n","print(criticisms)"],"metadata":{"id":"aq_WZBD-Gi-i","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1733151385796,"user_tz":300,"elapsed":125,"user":{"displayName":"Fernando Pasquini","userId":"05908162714866376060"}},"outputId":"755acedd-c768-4683-b3c1-d47deb723465"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Prototypes (Cluster Centers):\n","[[-1.31184669e-01 -1.32629978e-01  6.29303064e-02 -1.13663875e-01\n","  -4.09080602e-01 -2.95999299e-01  4.17618686e-03 -5.38048746e-02\n","  -3.27256435e-01 -2.45209271e-01 -3.12810464e-01 -2.89775084e-01\n","  -2.89093015e-01 -1.93343819e-01 -1.88669333e-01]\n"," [-1.23633781e-01  1.67435348e-01 -5.11281316e-02  8.31271614e-02\n","   2.45840921e-01  1.46466301e-01 -2.07612298e-01 -1.41677756e-01\n","   6.09525614e-02 -3.49975601e-02  3.14018463e+00  3.05205944e+00\n","   3.01813108e+00  9.61508841e-01  8.35582128e-01]\n"," [ 8.03290803e-01  2.97082962e-01  1.35235636e-01  6.13243458e-01\n","   6.10057483e-01  8.12851535e-01  5.99355705e-02  4.39729968e-01\n","   6.39304739e-01  3.88254517e-01  3.14018463e+00  2.40608350e+00\n","   3.01813108e+00  6.62401221e+00  6.91125556e+00]\n"," [ 8.85167479e-01  1.08022585e-02 -3.45734123e-02  6.14708930e-01\n","  -3.25151583e-01 -2.1627799